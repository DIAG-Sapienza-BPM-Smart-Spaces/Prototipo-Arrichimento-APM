digraph G {
  compound=true;
  rankdir=TB;
  bgcolor="white";
  node [fontname="Helvetica", fontsize=11, margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  /* ===================== (2) per-record pipeline ===================== */
  subgraph cluster_flow {
    label="②  Per-record pipeline   (router.py :: process_row)";
    labeljust=l; fontsize=14; fontname="Helvetica-Bold";
    style="rounded"; color="#9aa0a6"; bgcolor="#fafafa"; margin=16;

    start [label="Maintenance record\n(note + material)", shape=box, style="rounded,filled", fillcolor="#d9ead3", color="#7fae6f"];
    clean [label="Clean text\n(text_cleaner.py)", shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bdbdbd"];
    cache [label="Seen before?\n(cache)", shape=diamond, style=filled, fillcolor="#fff2cc", color="#d6b656"];
    s1    [label="Stage 1 — free understanding  (LLM)\nsistema_libero, sintomo_libero, actions, material", shape=box, style="rounded,filled", fillcolor="#cfe2f3", color="#6c8ebf"];
    assign[label="Online assign — 4 growing fields\nsistema · sintomo · azione · componente", shape=box, style="rounded,filled", fillcolor="#d9d2e9", color="#8a7fb0"];
    s2    [label="Stage 2 — structured completion  (LLM)\ntipo · esito (fixed) · luogo · translate material", shape=box, style="rounded,filled", fillcolor="#cfe2f3", color="#6c8ebf"];
    val   [label="Validate + normalize\n(validator.py)", shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bdbdbd"];
    conf  [label="Confidence\nHIGH / MEDIUM / LOW", shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bdbdbd"];
    out   [label="Write row →\noutput/processed_*.xlsx", shape=box, style="rounded,filled", fillcolor="#d9ead3", color="#7fae6f"];

    start -> clean -> cache;
    cache -> s1  [label="no"];
    cache -> out [label="yes (cached)", style=dashed, constraint=false];
    s1 -> assign -> s2 -> val -> conf -> out;
  }

  /* ===================== (1) assign() decision ===================== */
  subgraph cluster_assign {
    label="①  assign() — how ONE value joins an existing category or creates a new one   (online_taxonomy.py)";
    labeljust=l; fontsize=14; fontname="Helvetica-Bold";
    style="rounded"; color="#9aa0a6"; bgcolor="#fafafa"; margin=16;

    a0 [label="One phrase\n(e.g. \"centralina motore\")", shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bdbdbd"];
    a1 [label="Embed → nearest existing\ncluster (cosine similarity)", shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bdbdbd"];
    a2 [label="sim ≥ threshold?\n(0.72;  componente 0.88)", shape=diamond, style=filled, fillcolor="#fff2cc", color="#d6b656"];
    join1 [label="Join that cluster", shape=box, style="rounded,filled", fillcolor="#d9ead3", color="#7fae6f"];
    gate [label="LLM gate: is it one of the\ntop-k existing categories?", shape=diamond, style=filled, fillcolor="#cfe2f3", color="#6c8ebf"];
    join2 [label="Join\n(a duplicate the embedding missed)", shape=box, style="rounded,filled", fillcolor="#d9ead3", color="#7fae6f"];
    create [label="Create NEW cluster + name it\n(standard term, else invent)", shape=box, style="rounded,filled", fillcolor="#d9ead3", color="#7fae6f"];
    note [label="No ALTRO — every value ends in a category", shape=note, style=filled, fillcolor="#ffffff", color="#bbbbbb", fontsize=10];

    a0 -> a1 -> a2;
    a2 -> join1 [label="yes"];
    a2 -> gate  [label="no"];
    gate -> join2  [label="match"];
    gate -> create [label="new"];
    create -> note [style=invis];
  }

  assign -> a0 [lhead=cluster_assign, style=dashed, color="#7a6fa8", fontcolor="#7a6fa8",
                label="  each of the 4 values\n  runs through assign()", constraint=false];

  /* ===================== legend ===================== */
  subgraph cluster_legend {
    label="Legend"; fontsize=12; fontname="Helvetica-Bold"; style="rounded"; color="#cccccc"; margin=10;
    lg1 [label="LLM call", shape=box, style="rounded,filled", fillcolor="#cfe2f3", color="#6c8ebf", fontsize=10];
    lg2 [label="local / deterministic", shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#bdbdbd", fontsize=10];
    lg3 [label="decision", shape=diamond, style=filled, fillcolor="#fff2cc", color="#d6b656", fontsize=10];
    lg4 [label="start / result", shape=box, style="rounded,filled", fillcolor="#d9ead3", color="#7fae6f", fontsize=10];
    lg1 -> lg2 -> lg3 -> lg4 [style=invis];
    rank=same;
  }
}
